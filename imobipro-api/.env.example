# Copie para .env e ajuste. Este arquivo NÃO contém segredo real.
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=troque-esta-chave-em-producao-com-50-caracteres-aleatorios
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api

DATABASE_URL=postgres://imobipro:imobipro@db:5432/imobipro
REDIS_URL=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Limites de requisição. Em produção valem 5/min no login e 600/hour anônimo;
# o ambiente local afrouxa para caber a suíte E2E. Login e renovação de sessão
# têm baldes próprios: navegar pela vitrine pública não pode trancar a equipe
# para fora do sistema.
THROTTLE_LOGIN=200/min
THROTTLE_CADASTRO=200/hour
THROTTLE_ANON=2000/hour
THROTTLE_USER=10000/hour
THROTTLE_REFRESH=600/min
THROTTLE_CONTATO_PUBLICO=500/hour
THROTTLE_ACOMPANHAMENTO=2000/hour
# Quantos proxies existem na frente da API (nginx = 1; CDN + nginx = 2). É o que
# faz o limite valer por visitante, e não por endereço do proxy.
NUM_PROXIES=1
LOG_LEVEL=INFO

# Produção (não usados em desenvolvimento)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=nao-responda@imobipro.com.br
